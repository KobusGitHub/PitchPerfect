rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles are readable by any signed-in user. Only Cloud Functions (Admin SDK) write them.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Camp sites are shared by all signed-in users. Writes must carry the four text fields.
    match /campSites/{siteId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'province', 'phone', 'email'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.province is string && request.resource.data.province.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0;
    }
  }
}
